# Qwen (Alibaba / OpenAI-compatible) - optional; falls back to deterministic text if missing
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=your-qwen-key
QWEN_MODEL=qwen3.8-max

# Hermes plugin points here; set to the Vercel URL after deploy
BANJIR_API_BASE=http://localhost:8000

# Optional cache paths (Vercel uses /tmp by default)
BANJIR_JPS_CACHE=/tmp/banjir_jps_cache.json
BANJIR_MET_CACHE=/tmp/banjir_met_cache.json
